# Copy to .env and fill in. .env is gitignored.
# Application code reads ANTHROPIC_* only. source env.sh maps the
# PARALLIGHT_* aliases below when the matching ANTHROPIC_* value is empty.

# Direct Anthropic API (sent as x-api-key).
ANTHROPIC_API_KEY=

# Bearer token for a compatible gateway (sent as Authorization: Bearer).
# If both this and ANTHROPIC_API_KEY are set, the bearer token wins.
# ANTHROPIC_AUTH_TOKEN=

# Base URL with no path. Default: https://api.anthropic.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Legacy aliases. Leave unset when ANTHROPIC_* above is set.
# PARALLIGHT_API_KEY=
# PARALLIGHT_BASE_URL=

# OBS → Tools → WebSocket Server Settings
OBS_PASSWORD=

# OBS_URL=ws://localhost:4455
# OBS_PORT=4455

# Assistant HTTP port
# PORT=8788

# FFMPEG=ffmpeg
# FFPROBE=ffprobe
# CORPUS_DIR=./corpus
# TRANSCRIBE_MODEL=small
